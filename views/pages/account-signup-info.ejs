<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit Signup Info | Find FIRST</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/main.css?v=54">
</head>
<body>
      <header></header>

  <main>
    <div class="container">
      <a href="<%= backUrl || '/account' %>" class="btn btn-secondary back-button"><%= backTarget === 'applications' ? '← Back to Applications' : backTarget === 'teams' ? '← Back to Teams' : '← Back to Account' %></a>

      <h1>Edit Signup Info</h1>
      <p class="subtitle">Update the signup details saved on your account.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form id="accountSignupForm" class="form-grid" method="POST" action="/account/signup-info">
        <input type="hidden" name="back" value="<%= backTarget || 'account' %>">
        <label for="name">Full name</label>
        <input id="name" name="name" value="<%= values && values.name ? values.name : '' %>" required>

        <label for="country">Country</label>
        <select id="country" name="country" autocomplete="country-name" data-country-select required>
          <option value="">Select a country</option>
          <% unitedNationsCountries.forEach(function(countryName) { %>
            <option value="<%= countryName %>" <%= values && countriesMatch(values.country, countryName) ? 'selected' : '' %>><%= countryName %></option>
          <% }); %>
        </select>

        <label for="state">State, province, or region</label>
        <select id="state" name="state" autocomplete="address-level1" data-region-select required>
          <option value="">Select a state, province, or region</option>
          <% countryRegionsFor(values && values.country).forEach(function(regionName) { %>
            <option value="<%= regionName %>" <%= values && canonicalizeCountryRegion(values.country, values.state) === regionName ? 'selected' : '' %>><%= regionName %></option>
          <% }); %>
        </select>

        <label for="currentGrade">Current grade</label>
        <select id="currentGrade" name="currentGrade" required>
          <option value="">Select your grade for the current school year</option>
          <% ['Kindergarten', 'Grade 1', 'Grade 2', 'Grade 3', 'Grade 4', 'Grade 5', 'Grade 6', 'Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'].forEach(function(grade) { %>
            <option value="<%= grade %>" <%= values && values.currentGrade === grade ? 'selected' : '' %>><%= grade %></option>
          <% }); %>
        </select>

        <label for="experience">Experience (brief)</label>
        <textarea id="experience" name="experience" rows="4" maxlength="500" placeholder="e.g., none, some Java, built RC car"><%= values && values.experience ? values.experience : '' %></textarea>

        <label for="interests">Interests / Roles</label>
        <input id="interests" name="interests" maxlength="200" placeholder="programming, mechanical, outreach" value="<%= values && values.interests ? values.interests : '' %>">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= values && values.email ? values.email : '' %>" required>

        <label for="phone">Phone (optional)</label>
        <input id="phone" name="phone" type="tel" value="<%= values && values.phone ? values.phone : '' %>">

        <div></div>
        <div>
          <button type="submit" class="btn btn-primary"><%= backTarget === 'teams' ? 'Save & Return to Teams' : 'Save Signup Info' %></button>
        </div>
      </form>
    </div>
  </main>

  <script src="/assets/js/main.js?v=75"></script>
</body>
</html>
