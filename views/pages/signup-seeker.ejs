<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sign Up — Join or Start a Team</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/assets/css/main.css?v=54">
</head>
<body class="auth-page">
  <header></header>

  <main>
    <div class="container">
      <a href="<%= nextPath ? '/auth-gate?next=' + encodeURIComponent(nextPath) : '/signup' %>" class="btn btn-secondary back-button">← Back</a>
      <h1>Sign Up — Looking to Join or Start a Team</h1>
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form id="signupForm" method="POST" action="/signup">
        <input type="hidden" name="signupMode" value="seeker" />
        <input type="hidden" name="inviteToken" value="<%= inviteToken || '' %>" />
        <input type="hidden" name="next" value="<%= nextPath || '' %>" />

        <div class="mb-3">
          <label class="form-label">Full name</label>
          <input name="name" id="name" class="form-control" value="<%= values && values.name ? values.name : '' %>" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input name="email" id="email" type="email" class="form-control" value="<%= values && values.email ? values.email : '' %>" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input name="password" id="password" type="password" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label" for="dateOfBirth">Date of birth</label>
          <input name="dateOfBirth" id="dateOfBirth" type="date" class="form-control" value="<%= values && values.dateOfBirth ? values.dateOfBirth : '' %>" required />
          <small class="text-muted">You must be at least 13 years old to create an account.</small>
        </div>
        <div class="mb-3">
          <label class="form-label" for="country">Country</label>
          <select name="country" id="country" class="form-control" autocomplete="country-name" data-country-select required>
            <option value="">Select a country</option>
            <% unitedNationsCountries.forEach(function(countryName) { %>
              <option value="<%= countryName %>" <%= values && countriesMatch(values.country, countryName) ? 'selected' : '' %>><%= countryName %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="state">State, province, or region</label>
          <select name="state" id="state" class="form-control" autocomplete="address-level1" data-region-select required>
            <option value="">Select a state, province, or region</option>
            <% countryRegionsFor(values && values.country).forEach(function(regionName) { %>
              <option value="<%= regionName %>" <%= values && canonicalizeCountryRegion(values.country, values.state) === regionName ? 'selected' : '' %>><%= regionName %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Phone</label>
          <input name="phone" id="phone" type="tel" class="form-control" value="<%= values && values.phone ? values.phone : '' %>" required />
        </div>

        <div class="mb-3">
          <label class="form-label" for="interests">Interests / Roles</label>
          <input
            name="interests"
            id="interests"
            class="form-control"
            value="<%= values && values.interests ? values.interests : '' %>"
            placeholder="Example: programming, CAD, mechanical, driving, outreach"
            maxlength="200"
            required
          />
        </div>

        <div class="mb-3">
          <label class="form-label" for="experience">Experience</label>
          <textarea
            name="experience"
            id="experience"
            class="form-control"
            rows="4"
            placeholder="Example: beginner, 1 year in FTC, built robots before"
            maxlength="500"
            required
          ><%= values && values.experience ? values.experience : '' %></textarea>
        </div>

        <div class="mb-3 agreement-row">
          <label class="form-label agreement-label">
            <input name="policyAccepted" type="checkbox" value="1" required <%= values && ['1', 'on', 'true'].includes(String(values.policyAccepted || '').toLowerCase()) ? 'checked' : '' %> />
            <span>I agree to the privacy policy</span>
          </label>
          <a class="btn terms-button" href="/terms#usercentrics-ppg">View privacy policy</a>
        </div>
        <div class="mb-3 agreement-row">
          <label class="form-label agreement-label">
            <input name="termsAccepted" type="checkbox" value="1" required <%= values && ['1', 'on', 'true'].includes(String(values.termsAccepted || '').toLowerCase()) ? 'checked' : '' %> />
            <span>I agree to the terms and conditions</span>
          </label>
          <a class="btn terms-button" href="/terms-of-conditions#usercentrics-ppg">View terms and conditions</a>
        </div>

        <button class="btn btn-primary" type="submit">Create account</button>
      </form>

      <p style="margin-top:14px">Already have an account? <a href="/login<%= nextPath ? '?next=' + encodeURIComponent(nextPath) : '' %>">Log in</a></p>
    </div>
  </main>

  <script src="/assets/js/main.js?v=75"></script>
</body>
</html>
