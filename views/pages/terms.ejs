<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Terms & Policy - FTC Starter Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/assets/css/main.css?v=13">
</head>
<body class="auth-page">
  <header></header>

  <main>
    <div class="container" style="max-width: 860px;">
      <a href="/signup" class="btn btn-secondary back-button" data-terms-back-link>&larr; Back to signup</a>

      <div id="usercentrics-ppg" class="uc-privacy-policy">
        <% if (policyHtml) { %>
          <%- policyHtml %>
        <% } else { %>
          <div style="padding: 24px 0; color: #334155; font-size: 15px; line-height: 1.6;">
            Loading the official privacy policy…
          </div>
          <script
            id="usercentrics-ppg-script"
            privacy-policy-id="fb54bbd7-7e7d-41ed-ae56-bfeb13277b45"
            data-language="en"
            src="https://policygenerator.usercentrics.eu/api/privacy-policy"
          ></script>
        <% } %>
      </div>

      <script nonce="<%= cspNonce %>">
        (() => {
          try {
            const backLink = document.querySelector('[data-terms-back-link]');
            if (!backLink) return;
            const returnUrl = sessionStorage.getItem('signup_terms_return_url');
            if (returnUrl) backLink.setAttribute('href', returnUrl);
          } catch (e) {}
        })();
      </script>
    </div>
  </main>

  <script src="/assets/js/main.js?v=43"></script>
</body>
</html>
