<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Teams Near Me - Find FIRST</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/main.css?v=64">
  <!-- Font Awesome for marker icon -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="find-teams">
  <header>
    
  </header>

  <main>
    <div class="container" id="teamsContainer">
      <% if (typeof reportSent !== 'undefined' && reportSent) { %>
        <div class="alert alert-success">Your report was submitted for review.</div>
      <% } %>
      <% if (typeof reportError !== 'undefined' && reportError) { %>
        <div class="alert alert-danger"><%= reportError %></div>
      <% } %>
      <div class="button-group">
        <a href="/account/signup-info" class="btn btn-secondary back-button">← Edit Info</a>
        <a href="/my-applications" class="btn btn-secondary">View My Applications</a>
      </div>
      <h1>Teams Near You</h1>
      <p id="teamsStatus" class="subtitle"><%= typeof databaseUnavailable !== 'undefined' && databaseUnavailable ? 'Team listings are temporarily unavailable. Please try again shortly.' : 'Looking for teams...' %></p>
      <form id="zipLocationForm" class="zip-location-form" novalidate>
        <label for="zipLocationInput">Search by team name, city, county, state, country, or ZIP</label>
        <div class="zip-location-row">
          <input id="zipLocationInput" name="q" type="text" placeholder="Type a team name, city, state, country, or ZIP" autocomplete="off" />
          <button type="submit" class="btn btn-secondary">Update</button>
        </div>
        <p id="zipLocationMessage" class="zip-location-message" aria-live="polite"></p>
      </form>

      <div id="teamsList" class="teams-list">
        <!-- Teams will be rendered here -->
      </div>
    </div>
  </main>

  <!-- Server-provided page state is base64-encoded inside escaped attributes. -->
  <script
    data-teams-base64="<%= jsonToBase64(typeof teams !== 'undefined' ? teams : null) %>"
    data-user-coords-base64="<%= jsonToBase64(typeof userCoords !== 'undefined' ? userCoords : null) %>"
    data-student-app-base64="<%= jsonToBase64(typeof studentApp !== 'undefined' ? studentApp : null) %>"
    data-user-base64="<%= jsonToBase64(typeof user !== 'undefined' ? user : null) %>">
    // Public team listings include each team's published contact email.
    const decodePageData = encoded => encoded
      ? JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(encoded), char => char.charCodeAt(0))))
      : null;
    window.__TEAMS__ = decodePageData(document.currentScript.dataset.teamsBase64);
    window.__USER_COORDS__ = decodePageData(document.currentScript.dataset.userCoordsBase64);
    window.__STUDENT_APP__ = decodePageData(document.currentScript.dataset.studentAppBase64);
    window.__USER__ = decodePageData(document.currentScript.dataset.userBase64);
    window.__GOOGLE_MAPS_ENABLED__ = <%= googleMapsApiKey ? 'true' : 'false' %>;
  </script>

  <script src="/assets/js/main.js?v=90"></script>
  <% if (googleMapsApiKey) { %>
    <script async src="https://maps.googleapis.com/maps/api/js?key=<%= encodeURIComponent(googleMapsApiKey) %>&loading=async&callback=initGoogleTeamsMap&v=weekly"></script>
  <% } %>
</body>
</html>
