<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Register Team - FTC Starter Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/assets/css/main.css?v=13">
</head>
<body>
  <header>
    
  </header>

  <main>
    <div class="container">
      <a href="/" class="btn btn-secondary back-button">&larr; Back Home</a>
      <h1>Register Your Team</h1>
      <p class="subtitle">Verified FIRST teams can choose whether they appear for students looking nearby, FLL teams can register too, and new teams can create a listing while they are getting organized.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <form method="POST" action="/team-register" class="form-grid">
        <% const selectedMode = values.registrationMode || 'existing'; %>
        <% const selectedProgram = values.program || 'FTC'; %>
        <% const showRegistrationExtras = selectedMode !== 'new' && selectedProgram === 'FLL Challenge'; %>

        <div class="registration-choice form-grid-full">
          <p class="registration-choice-question">Choose how you want to register</p>
          <div class="registration-choice-options" role="radiogroup" aria-label="Registration mode">
            <label class="choice-pill">
              <input type="radio" name="registrationMode" value="existing" <%= selectedMode === 'new' ? '' : 'checked' %> />
              <span>Official FIRST team</span>
            </label>
            <label class="choice-pill">
              <input type="radio" name="registrationMode" value="new" <%= selectedMode === 'new' ? 'checked' : '' %> />
              <span>New team</span>
            </label>
          </div>
          <p class="registration-choice-note">Use official team verification for an existing FIRST record, or choose new team if you are starting a team that has not been registered yet.</p>
        </div>

        <div class="form-grid-full" data-firstauth-status>
          <% if (typeof firstAuthVerification !== 'undefined' && firstAuthVerification) { %>
            <div class="alert alert-success">
              FirstAuth verified <strong><%= firstAuthVerification.program %> <%= firstAuthVerification.teamNumber %></strong>
              <%= firstAuthVerification.displayName ? ' for ' + firstAuthVerification.displayName : '' %>.
            </div>
          <% } else { %>
            <p class="form-note text-muted">Existing teams must verify membership through FirstAuth before the listing can be saved.</p>
          <% } %>
        </div>

        <label for="program">FIRST program</label>
        <select id="program" name="program" required>
          <option value="FTC" <%= selectedProgram === 'FTC' ? 'selected' : '' %>>FIRST Tech Challenge</option>
          <option value="FRC" <%= selectedProgram === 'FRC' ? 'selected' : '' %>>FIRST Robotics Competition</option>
          <option value="FLL Challenge" <%= selectedProgram === 'FLL Challenge' ? 'selected' : '' %>>FIRST LEGO League Challenge</option>
        </select>

        <div class="registration-field-inline form-grid-full <%= selectedMode === 'new' ? 'registration-hidden' : '' %>" data-registration-field="teamNumber">
          <label for="teamNumber">Team number</label>
          <input id="teamNumber" name="teamNumber" type="number" min="1" <%= selectedMode === 'new' ? '' : 'required' %> value="<%= values.teamNumber || '' %>" />
        </div>

        <label for="name">Team name</label>
        <input id="name" name="name" required value="<%= values.name || '' %>" />

        <label for="contact">Contact email</label>
        <input id="contact" name="contact" type="email" required value="<%= values.contact || '' %>" />

        <label for="address">Address</label>
        <input id="address" name="address" required placeholder="Street address, meeting area, or landmark" value="<%= values.address || '' %>" />
        <% if (!(selectedMode !== 'new' && (selectedProgram === 'FTC' || selectedProgram === 'FRC'))) { %>
          <small class="text-muted form-note form-grid-full">For team privacy, the map marker is offset from the exact address and shown inside a 1000 meter bubble.</small>
        <% } %>

        <% const showLocationFields = selectedMode === 'new' || selectedProgram === 'FLL Challenge'; %>
        <div class="registration-location-grid form-grid-full <%= showLocationFields ? '' : 'registration-hidden' %>" data-team-location-fields>
          <label for="city">City</label>
          <input id="city" name="city" required value="<%= values.city || '' %>" />

          <label for="state">State</label>
          <input id="state" name="state" value="<%= values.state || '' %>" />

          <label for="country">Country</label>
          <input
            id="country"
            name="country"
            type="text"
            required
            value="<%= values.country || '' %>"
            placeholder="Country (for example, USA, Canada, India)"
          />
        </div>

        <label for="notes">Recruiting info</label>
        <textarea id="notes" name="notes" rows="4" placeholder="Meeting days, grades accepted, application link, or what students should include."><%= values.notes || '' %></textarea>

        <div class="registration-extra-grid form-grid-full <%= showRegistrationExtras ? '' : 'registration-hidden' %>" data-registration-extras>
          <label for="awards">Awards</label>
          <input id="awards" name="awards" placeholder="Optional: Inspire Award, Control Award, regional finalist, etc." value="<%= values.awards || '' %>" />

          <label for="yearsInProgram">Years in program</label>
          <input id="yearsInProgram" name="yearsInProgram" type="number" min="0" step="1" placeholder="Optional: 1, 3, 6..." value="<%= values.yearsInProgram || '' %>" />
        </div>

        <span></span>
        <label class="checkbox-row">
          <input type="checkbox" name="recruiting" <%= values.recruiting === undefined || values.recruiting === 'on' ? 'checked' : '' %> />
          <span>Show this team as recruiting</span>
        </label>

        <span></span>
        <div class="registration-submit-actions">
          <button
            class="btn btn-primary"
            type="submit"
            formaction="/team-register/firstauth"
            data-firstauth-submit
          >Verify Team Ownership with FirstAuth</button>
          <button class="btn btn-primary" type="submit" data-team-save>Save Team</button>
          <small class="text-muted" data-firstauth-requirements>Complete every required field before verifying ownership.</small>
          <% if (typeof firstAuthConfigured !== 'undefined' && !firstAuthConfigured) { %>
            <small class="text-muted">FirstAuth credentials must be configured by the site administrator.</small>
          <% } %>
        </div>
      </form>
    </div>
  </main>

  <script src="/assets/js/main.js?v=37"></script>
  <script>
    (function() {
      const form = document.querySelector('.form-grid');
      if (!form) return;
      const modeInputs = Array.from(form.querySelectorAll('input[name="registrationMode"]'));
      const teamNumberField = form.querySelector('[data-registration-field="teamNumber"]');
      const extrasField = form.querySelector('[data-registration-extras]');
      const teamNumberInput = form.querySelector('#teamNumber');
      const awardsInput = form.querySelector('#awards');
      const yearsInput = form.querySelector('#yearsInProgram');
      const extraInputs = [awardsInput, yearsInput].filter(Boolean);
      const locationFields = form.querySelector('[data-team-location-fields]');
      const firstAuthButton = form.querySelector('[data-firstauth-submit]');
      const saveButton = form.querySelector('[data-team-save]');
      const firstAuthStatus = form.querySelector('[data-firstauth-status]');
      const firstAuthRequirements = form.querySelector('[data-firstauth-requirements]');
      const verifiedProgram = <%- JSON.stringify(typeof firstAuthVerification !== 'undefined' && firstAuthVerification ? firstAuthVerification.program : '') %>;
      const verifiedTeamNumber = <%- JSON.stringify(typeof firstAuthVerification !== 'undefined' && firstAuthVerification ? String(firstAuthVerification.teamNumber) : '') %>;

      function syncMode() {
        const selected = modeInputs.find(input => input.checked);
        const isNew = selected && selected.value === 'new';
        const programValue = String(form.querySelector('#program')?.value || '').trim();
        const isOfficial = !isNew && (programValue === 'FTC' || programValue === 'FRC');
        const showExtras = !isNew && programValue === 'FLL Challenge';
        const showLocation = !isOfficial;

        if (teamNumberField) teamNumberField.classList.toggle('registration-hidden', isNew);
        if (teamNumberInput) {
          teamNumberInput.required = !isNew;
          teamNumberInput.disabled = isNew;
          if (isNew) teamNumberInput.value = '';
        }

        if (locationFields) locationFields.classList.toggle('registration-hidden', !showLocation);
        ['city', 'state', 'country'].forEach((fieldName) => {
          const input = form.querySelector(`#${fieldName}`);
          if (!input) return;
          input.disabled = !showLocation;
          input.required = showLocation && (fieldName === 'city' || fieldName === 'country');
          if (!showLocation) input.value = '';
        });

        if (extrasField) extrasField.classList.toggle('registration-hidden', !showExtras);
        extraInputs.forEach((input) => {
          input.disabled = !showExtras;
        });

        const proofMatches = !isNew
          && verifiedProgram === programValue
          && verifiedTeamNumber === String(teamNumberInput?.value || '').trim();
        if (firstAuthButton) firstAuthButton.hidden = isNew || proofMatches;
        if (firstAuthButton) firstAuthButton.disabled = isNew;
        if (saveButton) saveButton.hidden = !isNew && !proofMatches;
        if (firstAuthStatus) firstAuthStatus.hidden = isNew;
        if (firstAuthRequirements) firstAuthRequirements.hidden = isNew || proofMatches || form.checkValidity();

      }

      modeInputs.forEach(input => input.addEventListener('change', syncMode));
      const programInput = form.querySelector('#program');
      if (programInput) programInput.addEventListener('change', syncMode);
      if (teamNumberInput) teamNumberInput.addEventListener('input', syncMode);
      form.addEventListener('input', syncMode);
      form.addEventListener('change', syncMode);
      syncMode();
    })();
  </script>
</body>
</html>
