<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify your email - FTC Starter Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/assets/css/main.css?v=13">
</head>
<body class="auth-page">
  <header></header>

  <main>
    <div class="container" style="max-width: 760px;">
      <a href="<%= formUrl || '/signup' %>" class="btn btn-secondary back-button">← Back to signup</a>
      <h1>Verify your email</h1>
      <p class="text-muted" style="margin-bottom: 20px;">
        We sent a 6-digit verification code to <strong><%= email %></strong>.
        Enter it below to finish creating your account.
      </p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert" style="background:#e9f8ef;border-color:#b8edcb;color:#0f5b34;"><%= success %></div>
      <% } %>

      <form method="POST" action="/signup/verify" style="display:grid; gap:16px;">
        <div class="mb-3">
          <label class="form-label" for="verificationCode">Verification code</label>
          <input
            id="verificationCode"
            name="verificationCode"
            class="form-control"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            placeholder="123456"
            required
          />
        </div>

        <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center;">
          <button class="btn btn-primary" type="submit">Verify and create account</button>
          <button class="btn btn-secondary" type="submit" formaction="/signup/verify/resend" formnovalidate data-resend-code-button>Resend code</button>
        </div>
      </form>
    </div>
  </main>

  <script src="/assets/js/main.js?v=43"></script>
  <script>
    (function() {
      const resendButton = document.querySelector('[data-resend-code-button]');
      if (!resendButton) return;

      const resendAvailableAt = Number(<%= Number(typeof resendAvailableAt !== 'undefined' ? resendAvailableAt : 0) %>);
      if (!resendAvailableAt) return;

      let timerId = null;

      function formatRemaining(remainingMs) {
        const totalSeconds = Math.max(0, Math.ceil(remainingMs / 1000));
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${String(seconds).padStart(2, '0')}`;
      }

      function updateResendState() {
        const remainingMs = Math.max(0, resendAvailableAt - Date.now());
        if (remainingMs <= 0) {
          resendButton.disabled = false;
          resendButton.textContent = 'Resend code';
          if (timerId) {
            window.clearTimeout(timerId);
            timerId = null;
          }
          return;
        }

        resendButton.disabled = true;
        resendButton.textContent = `Resend code in ${formatRemaining(remainingMs)}`;

        timerId = window.setTimeout(updateResendState, Math.min(remainingMs, 1000));
      }

      updateResendState();
    })();
  </script>
</body>
</html>
